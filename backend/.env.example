# PostgreSQL connection string (e.g. from Supabase, Neon, or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fluentwave

# AWS Credentials for S3 Mock/Real uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
S3_BUCKET_NAME=fluentwave-docs-mock-bucket

# Express Server Port
PORT=4000
